function(revenge_gdk_valid root out)
  set(ok TRUE)
  foreach(rel IN ITEMS windows/include/XGameRuntime.h windows/include/XGameRuntimeInit.h windows/include/XTaskQueue.h windows/include/XSystem.h windows/lib/x64/xgameruntime.lib)
    if(NOT EXISTS "${root}/${rel}" OR IS_DIRECTORY "${root}/${rel}")
      set(ok FALSE)
    endif()
  endforeach()
  set(${out} ${ok} PARENT_SCOPE)
endfunction()
function(revenge_gdk_normalize input out)
  string(REPLACE "\\" "/" path "${input}")
  string(REGEX REPLACE "/+$" "" path "${path}")
  set(${out} "${path}" PARENT_SCOPE)
endfunction()
function(revenge_find_gdk explicit latest bases out)
  set(${out} "" PARENT_SCOPE)
  if(explicit)
    revenge_gdk_normalize("${explicit}" candidate)
    revenge_gdk_valid("${candidate}" ok)
    if(ok)
      set(${out} "${candidate}" PARENT_SCOPE)
    endif()
    return()
  endif()
  if(latest)
    revenge_gdk_normalize("${latest}" candidate)
    revenge_gdk_valid("${candidate}" ok)
    if(ok)
      set(${out} "${candidate}" PARENT_SCOPE)
      return()
    endif()
  endif()
  foreach(base IN LISTS bases)
    if(NOT base)
      continue()
    endif()
    revenge_gdk_normalize("${base}" base)
    file(GLOB versions LIST_DIRECTORIES true "${base}/[0-9]*")
    list(SORT versions COMPARE NATURAL ORDER DESCENDING)
    foreach(candidate IN LISTS versions)
      get_filename_component(version "${candidate}" NAME)
      if(NOT version MATCHES "^[0-9]+$")
        continue()
      endif()
      revenge_gdk_valid("${candidate}" ok)
      if(ok)
        set(${out} "${candidate}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
endfunction()
