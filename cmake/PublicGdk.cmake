# Optional public PC GDK only. Never download or copy SDK files.
option(REVENGE_ENABLE_GDK "Build optional Windows public GDK reference" ON)
set(REVENGE_GDK_ROOT "" CACHE PATH "Versioned public GDK directory (contains windows/include and windows/lib/x64)")
set(_gdk_enabled OFF)
if(WIN32 AND MSVC AND REVENGE_ENABLE_GDK AND CMAKE_SIZEOF_VOID_P EQUAL 8)
  include("${CMAKE_CURRENT_LIST_DIR}/FindPublicGdk.cmake")
  set(_gdk_bases "$ENV{GameDK}")
  if(DEFINED ENV{ProgramFiles\(x86\)})
    list(APPEND _gdk_bases "$ENV{ProgramFiles\(x86\)}/Microsoft GDK")
  endif()
  if(DEFINED ENV{ProgramFiles})
    list(APPEND _gdk_bases "$ENV{ProgramFiles}/Microsoft GDK")
  endif()
  revenge_find_gdk("${REVENGE_GDK_ROOT}" "$ENV{GameDKCoreLatest}" "${_gdk_bases}" _gdk_root)
  if(_gdk_root)
    add_executable(RevengeGdkReference samples/platform/gdk_desktop_reference.cpp)
    target_include_directories(RevengeGdkReference PRIVATE include "${_gdk_root}/windows/include")
    target_compile_definitions(RevengeGdkReference PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_link_libraries(RevengeGdkReference PRIVATE "${_gdk_root}/windows/lib/x64/xgameruntime.lib" Threads::Threads)
    set(_gdk_enabled ON)
    message(STATUS "Public Windows GDK reference enabled: ${_gdk_root}")
  elseif(REVENGE_GDK_ROOT)
    message(FATAL_ERROR "Explicit REVENGE_GDK_ROOT does not contain the required public Windows x64 headers/library")
  else()
    message(STATUS "Public Windows GDK not detected; optional reference disabled")
  endif()
endif()
file(WRITE "${CMAKE_BINARY_DIR}/revenge-gdk-enabled.txt" "${_gdk_enabled}\n")
if(BUILD_TESTING AND _gdk_enabled)
  add_test(NAME public_gdk_reference COMMAND RevengeGdkReference)
  set_tests_properties(public_gdk_reference PROPERTIES TIMEOUT 30)
  if(TARGET revenge_focused)
    add_dependencies(revenge_focused RevengeGdkReference)
  endif()
endif()
