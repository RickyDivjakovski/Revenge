include("${CMAKE_CURRENT_LIST_DIR}/../cmake/FindPublicGdk.cmake")
set(base "${CMAKE_CURRENT_BINARY_DIR}/gdk detection fixture")
file(REMOVE_RECURSE "${base}")
foreach(version IN ITEMS 9 20 100)
  file(MAKE_DIRECTORY "${base}/${version}/windows/include" "${base}/${version}/windows/lib/x64")
  foreach(header IN ITEMS XGameRuntime.h XGameRuntimeInit.h XTaskQueue.h XSystem.h)
    file(WRITE "${base}/${version}/windows/include/${header}" "synthetic placeholder")
  endforeach()
  if(NOT version EQUAL 100)
    file(WRITE "${base}/${version}/windows/lib/x64/xgameruntime.lib" "synthetic placeholder")
  endif()
endforeach()
revenge_find_gdk("" "${base}/100" "${base}" found)
if(NOT found STREQUAL "${base}/20")
  message(FATAL_ERROR "Incomplete latest did not fall back: ${found}")
endif()
revenge_find_gdk("${base}/9/" "${base}/20" "${base}" found)
if(NOT found STREQUAL "${base}/9")
  message(FATAL_ERROR "Override/trailing slash failed: ${found}")
endif()
revenge_find_gdk("${base}/100" "${base}/20" "${base}" found)
if(found)
  message(FATAL_ERROR "Invalid explicit path silently fell back")
endif()
string(REPLACE "/" "\\" backslash "${base}/9/")
revenge_find_gdk("" "${backslash}" "${base}" found)
if(NOT found STREQUAL "${base}/9")
  message(FATAL_ERROR "Backslash normalisation failed: ${found}")
endif()
file(REMOVE_RECURSE "${base}")
message(STATUS "GDK discovery: synthetic fallback, natural version order, explicit priority, invalid override and separator checks passed")
