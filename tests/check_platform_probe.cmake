execute_process(COMMAND "${PROBE}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT text MATCHES "REVENGE-PROBE-V1 collision=1 masks=1,3,7,15 score=4")
 message(FATAL_ERROR "Host probe failed: ${text} ${err}")
endif()
file(WRITE "${OUT}" "debug: REVENGE-PROBE-V1 collision=1 masks=1,3,7,15 score=4\n")
execute_process(COMMAND "${PROBE}" --compare "${OUT}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Valid trace rejected")
endif()
foreach(bad IN ITEMS "REVENGE-PROBE-V1 collision=1 masks=1,3,7,15 score=3" "not a trace" "REVENGE-PROBE-V1 collision=1 masks=1,3,7,15 score=4\nREVENGE-PROBE-V1 collision=1 masks=1,3,7,15 score=4")
 file(WRITE "${OUT}" "${bad}\n")
 execute_process(COMMAND "${PROBE}" --compare "${OUT}" RESULT_VARIABLE code)
 if(code EQUAL 0)
  message(FATAL_ERROR "Invalid or duplicate trace accepted")
 endif()
endforeach()
file(REMOVE "${OUT}")
