if(NOT DEFINED EXE OR NOT DEFINED ARG OR NOT DEFINED MARKER)
  message(FATAL_ERROR "Missing GPU validation arguments")
endif()
execute_process(COMMAND "${EXE}" "${ARG}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 110)
message("GPU process exit: ${status}\nstdout:\n${out}\nstderr:\n${err}")
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "GPU process failed: ${status}")
endif()
string(FIND "${out}" "${MARKER}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "GPU success marker missing: ${MARKER}")
endif()

if(DEFINED DIAGNOSTIC_MARKER)
  string(FIND "${err}" "${DIAGNOSTIC_MARKER}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "GPU lifecycle marker missing: ${DIAGNOSTIC_MARKER}")
  endif()
endif()
