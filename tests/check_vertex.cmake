file(REMOVE "${OUTPUT}")
execute_process(COMMAND "${REVENGE}" package-create-narrow "${OUTPUT}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Custom vertex package failed")
endif()
execute_process(COMMAND "${CLIENT}" "${OUTPUT}" --vertex RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Custom vertex client failed")
endif()
