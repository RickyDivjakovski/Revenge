file(REMOVE "${OUTPUT}")
foreach(command package-create package-inspect package-app-test)
  execute_process(COMMAND "${REVENGE}" ${command} "${OUTPUT}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${command} failed: ${output} ${error}")
  endif()
endforeach()
execute_process(COMMAND "${REVENGE}" package-create "${OUTPUT}" RESULT_VARIABLE status)
if(status EQUAL 0)
  message(FATAL_ERROR "existing package overwritten")
endif()
file(REMOVE "${OUTPUT}")
