file(REMOVE "${OUTPUT}")
execute_process(COMMAND "${REVENGE}" package-create-minmax "${OUTPUT}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Minmax vertex package failed")
endif()
execute_process(COMMAND "${CLIENT}" "${OUTPUT}" --vertex RESULT_VARIABLE code)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Minmax vertex client failed")
endif()
