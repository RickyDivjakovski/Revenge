set(args run-native "${FIXTURE}" --trusted --timeout 2)
if(DIAG)
  set(args run-native "${FIXTURE}" --trusted --timeout 15 --diagnostics)
endif()
execute_process(COMMAND "${REVENGE}" ${args} RESULT_VARIABLE actual OUTPUT_VARIABLE output ERROR_VARIABLE err TIMEOUT 25)
if(NOT "${actual}" STREQUAL "${EXPECT}")
  message(FATAL_ERROR "Expected ${EXPECT}, got ${actual}: ${output} ${err}")
endif()
string(FIND "${output}" "${NEEDLE}" index)
if(index EQUAL -1)
  message(FATAL_ERROR "Missing ${NEEDLE}: ${output} ${err}")
endif()
message(STATUS "${output}")
