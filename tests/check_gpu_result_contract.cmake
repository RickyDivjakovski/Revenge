function(check_case arg expected message_fragment)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DEXE=${PROBE}" "-DARG=${arg}" "-DMARKER=verified marker" -P "${CMAKE_CURRENT_LIST_DIR}/check_gpu_result.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(expected STREQUAL "pass")
    if(NOT "${result}" STREQUAL "0")
      message(FATAL_ERROR "Valid process rejected: ${out}${err}")
    endif()
  else()
    if("${result}" STREQUAL "0")
      message(FATAL_ERROR "Invalid process accepted: ${arg}")
    endif()
    string(FIND "${out}${err}" "${message_fragment}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Wrong failure for ${arg}: ${out}${err}")
    endif()
  endif()
endfunction()
check_case(--ok pass "")
check_case(--silent fail "GPU success marker missing")
check_case(--stderr fail "GPU success marker missing")
check_case(--failure fail "GPU process failed: 7")
message(STATUS "GPU validation contract: valid output accepted; silent success, stderr-only marker and nonzero exit rejected.")

function(check_lifecycle mode expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DEXE=${PROBE}" "-DARG=${mode}" "-DMARKER=verified marker" "-DDIAGNOSTIC_MARKER=closed cache" -P "${CMAKE_CURRENT_LIST_DIR}/check_gpu_result.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(expected STREQUAL "pass")
    if(NOT "${result}" STREQUAL "0")
      message(FATAL_ERROR "Lifecycle check rejected: ${out}${err}")
    endif()
  else()
    if("${result}" STREQUAL "0")
      message(FATAL_ERROR "Missing lifecycle marker accepted")
    endif()
    string(FIND "${out}${err}" "GPU lifecycle marker missing" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Unexpected lifecycle failure: ${out}${err}")
    endif()
  endif()
endfunction()
check_lifecycle(--lifecycle pass)
check_lifecycle(--ok fail)
message(STATUS "GPU lifecycle contract: required stderr marker accepted, missing marker rejected.")
