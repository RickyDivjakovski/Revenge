file(REMOVE "${OUTPUT}")
execute_process(COMMAND "${REVENGE}" package-create "${OUTPUT}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "fixture package creation failed")
endif()
execute_process(COMMAND "${CLIENT}" "${OUTPUT}" ${MODE} RESULT_VARIABLE status)
file(REMOVE "${OUTPUT}")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "graphics ABI client failed")
endif()
