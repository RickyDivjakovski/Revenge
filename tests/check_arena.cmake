file(MAKE_DIRECTORY "${DIR}")
file(REMOVE "${DIR}/color.rsp" "${DIR}/legacy.rsp")
execute_process(COMMAND "${REVENGE}" package-create-color "${DIR}/color.rsp" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "color package failed")
endif()
execute_process(COMMAND "${REVENGE}" package-create "${DIR}/legacy.rsp" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "legacy package failed")
endif()
execute_process(COMMAND "${GAME}" --selftest "${DIR}/color.rsp" "${DIR}/legacy.rsp" ${MODE} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "integrated game test failed")
endif()
